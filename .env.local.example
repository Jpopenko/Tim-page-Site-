# Wix CRM — contact form integration
# Generate an API key at https://dev.wix.com → API Keys
# Required permissions: Contacts (Read/Write), Notes (Read/Write)
WIX_API_KEY=your-api-key-here

# Your Wix site's metaSiteId (from the Wix editor URL: ?metaSiteId=...)
WIX_SITE_ID=272f05f7-f2d1-4953-9159-52ef2f7be711

# Production URL — update when domain is confirmed
NEXT_PUBLIC_SITE_URL=https://timpage.com
